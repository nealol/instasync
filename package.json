{
  "name": "instasync",
  "version": "0.1.1-beta.10",
  "description": "Google-docs-like collaborative editing for Obsidian, powered by Yjs and y-sweet.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mts",
    "release": "node release.mjs"
  },
  "keywords": [
    "obsidian",
    "yjs",
    "collaboration",
    "crdt"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@types/node": "^16.11.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@wdio/cli": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "obsidian": "^1.7.2",
    "tslib": "2.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8",
    "wdio-obsidian-reporter": "^3.0.4",
    "wdio-obsidian-service": "^3.0.4",
    "ws": "^8.21.0",
    "y-sweet": "^0.9.1"
  },
  "dependencies": {
    "@y-sweet/client": "^0.9.1",
    "lib0": "^0.2.93",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  }
}
