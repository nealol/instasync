{
	"name": "@realtime-md/web",
	"version": "0.1.0",
	"description": "Read-only web viewer for publicly shared Realtime.md notes, served by the Rust server at /view/{id}.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run --project web-unit --config ../../vitest.config.ts"
	},
	"dependencies": {
		"katex": "^0.16.21",
		"mermaid": "^11.4.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"rehype-katex": "^7.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"shiki": "^3.4.0",
		"unist-util-visit": "^5.0.0",
		"yaml": "^2.8.2",
		"yjs": "^13.6.0"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.4",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
