{
  "name": "@realtime-md/plugin-api-types",
  "version": "0.2.0",
  "description": "TypeScript type definitions for the Realtime.md Obsidian plugin API (app.plugins.plugins[\"realtime\"]).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "obsidian",
    "realtime",
    "types"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "release": "npm publish --access public"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
